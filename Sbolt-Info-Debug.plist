<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Debug-only ATS exception so the Simulator can reach a plaintext local
	backend (APIConfiguration.environment == .development, http://localhost:8000)
	during development. Scoped to specific hosts, not NSAllowsArbitraryLoads.
	This file is wired to the Debug build configuration ONLY — Release uses
	the plain Sbolt-Info.plist with no ATS exception, so staging/production
	builds are unaffected and still require HTTPS everywhere.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
